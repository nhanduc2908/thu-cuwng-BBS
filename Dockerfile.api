FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PETCARE_DATABASE_PATH=/var/lib/petcare/pet_store.db

WORKDIR /app

COPY requirements-api.txt .
RUN python -m pip install --no-cache-dir -r requirements-api.txt

COPY app ./app

RUN groupadd --system petcare \
    && useradd --system --gid petcare --home-dir /var/lib/petcare petcare \
    && mkdir -p /var/lib/petcare \
    && chown -R petcare:petcare /var/lib/petcare /app

USER petcare
EXPOSE 8000

CMD ["uvicorn", "app.cloud_api:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
